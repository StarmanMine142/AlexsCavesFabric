{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "license": "${mod_license}",
  "icon": "assets/${mod_id}/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.github.alexmodguy.alexscaves.fabric.AlexsCavesFabric"
    ],
    "client": [
      "com.github.alexmodguy.alexscaves.fabric.AlexsCavesFabricClient"
    ],
    "jei_mod_plugin": [
      "com.github.alexmodguy.alexscaves.compat.jei.AlexsCavesPlugin"
    ],
    "rei_client": [
      "com.github.alexmodguy.alexscaves.compat.rei.AlexsCavesReiPlugin"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "accessWidener": "${mod_id}.accesswidener",
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "~${minecraft_version}",
    "java": ">=21"
  },
  "suggests": {
    "jei": "*"
  }
}
